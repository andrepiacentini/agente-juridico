# desafio.sqlite é versionado de propósito (D27) e nunca é alterado pelo projeto.

# Ambiente Python (recriado por `uv sync`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Segredos e configuração local — só o .env.example é versionado
.env
.env.*
!.env.example

# Registro de uso das respostas (E13): dado local de cada máquina
usage.sqlite

# Chainlit: o resto é gerado em execução; a configuração e a tradução pt-BR são do projeto (D70)
.chainlit/*
!.chainlit/config.toml
!.chainlit/translations/
.chainlit/translations/*
!.chainlit/translations/pt-BR.json
.files/

# Sistema e editores
.DS_Store
.vscode/
.idea/

# Configuração local do Claude Code (a compartilhada, .claude/settings.json, é versionada)
.claude/settings.local.json

# Orientações só do apresentador (roteiro da demo, respostas da arguição): ficam só nesta máquina
docs/apenas_para_mim/

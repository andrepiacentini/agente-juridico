# desafio.sqlite é versionado de propósito (D27) e nunca é alterado pelo projeto.

# Ambiente Python (recriado por `uv sync`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Segredos e configuração local — só o .env.example é versionado
.env
.env.*
!.env.example

# Chainlit (dados gerados em execução)
.chainlit/
.files/

# Sistema e editores
.DS_Store
.vscode/
.idea/

# Configuração local do Claude Code (a compartilhada, .claude/settings.json, é versionada)
.claude/settings.local.json

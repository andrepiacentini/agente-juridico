# Copie este arquivo para .env e ajuste. O .env nunca vai para o Git.

# Modelo usado pelo agente, no formato <provedor>:<modelo> (D08, D25).
# Local, padrão — roda no Ollama, nada sai da máquina:
LLM_MODEL=ollama:qwen3:4b-instruct-2507-q4_K_M
# Nuvem, alternativa — exige ANTHROPIC_API_KEY:
# LLM_MODEL=anthropic:claude-sonnet-5

# Endereço do Ollama, exigido pelo Pydantic AI para o prefixo ollama:.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chave da Anthropic; só é necessária com LLM_MODEL=anthropic:...
ANTHROPIC_API_KEY=

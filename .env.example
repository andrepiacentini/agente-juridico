# Copie este arquivo para .env e ajuste. O .env nunca vai para o Git.

# Modelo usado pelo agente, no formato <provedor>:<modelo> (D08, D25).
# Local, padrão — roda no Ollama, nada sai da máquina:
LLM_MODEL=ollama:qwen3:4b-instruct-2507-q4_K_M
# Nuvem, alternativa gratuita (plano gratuito do Google AI Studio) — exige GOOGLE_API_KEY
# e LLM_THINKING=low (no Gemini o limite de saída inclui o raciocínio, D30):
# LLM_MODEL=google:gemini-3.8-flash
# LLM_THINKING=low
# Nuvem, opcional — exige ANTHROPIC_API_KEY e crédito na conta Anthropic:
# LLM_MODEL=anthropic:claude-sonnet-5

# Modelos que a interface web oferece para troca na tela, sem reiniciar (opcional, T10.3). Separados por vírgula;
# o raciocínio de cada um vai depois de "@". O LLM_MODEL acima entra sempre, em primeiro lugar.
# LLM_MODEL_OPTIONS=ollama:qwen3:4b-instruct-2507-q4_K_M,google:gemini-3.8-flash@low

# Nível de raciocínio do modelo (opcional): low, medium, high, true ou false. Vazio = padrão do modelo.
# O modelo local (instruct) não raciocina; deixe vazio.
LLM_THINKING=

# Esconde o aviso de observabilidade que o Pydantic AI imprime no terminal.
PYDANTIC_AI_NO_BANNER=1

# Endereço do Ollama, exigido pelo Pydantic AI para o prefixo ollama:.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Registro de uso (tokens, modelo e tempo de cada resposta, E13); opcional — o padrão é usage.sqlite
# na raiz do projeto. Nunca aponte para o desafio.sqlite: o registro recusa esse caminho.
# USAGE_DB_PATH=/caminho/para/usage.sqlite

# Tabela de preços dos modelos (E13); opcional — o padrão é prices.toml na raiz do projeto.
# PRICES_PATH=/caminho/para/prices.toml

# Caminho do banco; opcional — o padrão é desafio.sqlite na raiz do projeto.
# DATABASE_PATH=/caminho/para/desafio.sqlite

# Chave do Google AI Studio; só é necessária com LLM_MODEL=google:...
GOOGLE_API_KEY=

# Chave da Anthropic; só é necessária com LLM_MODEL=anthropic:...
ANTHROPIC_API_KEY=
